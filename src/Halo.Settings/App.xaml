<Application x:Class="Halo.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Halo.Settings"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- The palette is lifted from the approved preview, unchanged: ink, two quieter greys, four
             frost levels for glass surfaces, and three accents. Blue belongs to selected navigation and
             focus only, mint means a thing is on, coral means it wants attention. -->
        <SolidColorBrush x:Key="Ink" Color="#F7F9FB" />
        <SolidColorBrush x:Key="Secondary" Color="#C2CCD7" />
        <SolidColorBrush x:Key="Quiet" Color="#82909F" />
        <SolidColorBrush x:Key="Frost" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="FrostHover" Color="#27FFFFFF" />
        <SolidColorBrush x:Key="FrostPressed" Color="#34FFFFFF" />
        <SolidColorBrush x:Key="FrostEdge" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="Navigation" Color="#7CB4FF" />
        <SolidColorBrush x:Key="Mint" Color="#78DDB2" />
        <SolidColorBrush x:Key="Coral" Color="#FF9A8B" />
        <SolidColorBrush x:Key="Graphite" Color="#64707D" />
        <SolidColorBrush x:Key="RailFill" Color="#3210151D" />
        <SolidColorBrush x:Key="Selected" Color="#2E7CB4FF" />
        <SolidColorBrush x:Key="SelectedEdge" Color="#557CB4FF" />
        <SolidColorBrush x:Key="Obsidian" Color="#52151A22" />

        <!-- Every control is templated. The preview's five faults were all default chrome showing
             through - a ScrollViewer's inset, a Button's blue pressed state - so nothing here inherits
             a stock template. -->
        <Style x:Key="Glass" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Frost}" />
            <Setter Property="BorderBrush" Value="{StaticResource FrostEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="local:Ui.Radius" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The hover state is an ADDITIVE sheen over whatever colour the button carries,
                             not a replacement background. Every accent-tinted surface here - the home
                             cards, the selected nav pill, a chosen option - would have lost its tint on
                             hover the moment a trigger overwrote Background with plain frost. -->
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{Binding Path=(local:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="Sheen" Background="Transparent"
                                    CornerRadius="{Binding Path=(local:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail's rows are glass like everything else in the window. They were flat transparent, which
             made the one selected row the only object in the rail and the rest a list of words.
             Selection is a left accent BAR plus a tint of the same accent, set per-item in code:
             3,1,1,1 keeps the glass outline while the bar hangs off the left edge. -->
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Glass}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- A 3px hairline: no arrows, no track, and dim until you go near it. It was 7px wide holding a
             bright 3px thumb, which is furniture down the side of a pane of glass. Implicit (no x:Key) so
             every ScrollViewer in the window gets it. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Width="7" Padding="2,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="1.5" Background="#26FFFFFF" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#8CFFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Caption/CloseCaption button styles used to live here, for a minimise/maximise/close set
             drawn by hand. They are gone with the buttons: DWM already draws those three, so the pair of
             them appeared twice, and the hand-drawn set could not offer Snap Layouts on hover. -->
    </Application.Resources>
</Application>
